# =============================================================================
# Phink Accounting — Backend miljøvariabler (kopier til backend/.env)
# =============================================================================

# 1) Domeneshop MariaDB 11.4 (bytt ut DITT_DB_PASSORD med passordet fra Domeneshop)
#    Merk: Spesialtegn i passordet (f.eks. @ : / ?) må URL-kodes.
DATABASE_URL=mysql+pymysql://phinkaccountin01:DITT_DB_PASSORD@phinkaccountin01.mysql.domeneshop.no:3306/phinkaccountin01?charset=utf8mb4

#    Eller bruk lokal SQLite ved lokal testing:
# DATABASE_URL=sqlite:///./phink_accounting.db

# 2) Domene, eier / administrator (gratis ubegrenset kundekonto + kundeservice-agent)
PUBLIC_DOMAIN=www.phink-acounting.no
OWNER_EMAILS=riveroosx7@gmail.com
# Sett ADMIN_SEED_PASSWORD første gang backend starter mot ny MariaDB-database
# så opprettes administrator- og kundekontoen din automatisk med sikkert hashet passord!
ADMIN_SEED_PASSWORD=BYTT_TIL_DITT_INNLOGGINGSPASSORD

# 3) Hemmelig nøkkel for innloggingstokens (lag en lang tilfeldig tekst i produksjon)
AUTH_SECRET=bytt-til-en-lang-tilfeldig-hemmelig-nokkel-i-produksjon

# 4) Lokal Llama 3.1 8B Instruct (eller sky-backup når PC-en er avslått)
LLAMA_SERVER_URL=http://127.0.0.1:9931
CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=llama-3.1-8b-instant
